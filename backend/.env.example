# Merge these media settings into your existing backend environment.
MEDIA_STORAGE=s3
# Used only by migration scripts, not by the running API.
LEGACY_UPLOAD_DIR=/var/opt/uploads
AWS_REGION=ap-south-1
S3_BUCKET=khotkarshubham.in
S3_PREFIX=
# Public S3 or CloudFront base URL, without S3_PREFIX. Leave empty for signed reads.
MEDIA_PUBLIC_URL=https://s3.ap-south-1.amazonaws.com/khotkarshubham.in
# Use an IAM role in production or AWS_PROFILE locally; never put credentials in VITE_*.

S3_LEGACY_PREFIX=portfolio/production
