# Merge these media settings into your existing backend environment.
MEDIA_STORAGE=local
UPLOAD_DIR=uploads
AWS_REGION=ap-south-1
S3_BUCKET=khotkarshubham.in
S3_PREFIX=
# Optional CloudFront origin URL, without the S3_PREFIX. Leave empty for signed S3 reads.
MEDIA_PUBLIC_URL=
# Use an IAM role in production or AWS_PROFILE locally; never put credentials in VITE_*.

S3_LEGACY_PREFIX=portfolio/production
